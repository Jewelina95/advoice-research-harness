{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advoice.local/schemas/case_evidence_package.schema.json",
  "title": "AD Voice label-free case evidence package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "config_hash", "data_snapshot_hash", "skill_hash", "case_id", "subject_id", "endpoint", "sessions", "tasks", "quality_summary", "supervised_prior", "state_cards", "metric_evidence", "metric_validation_records", "segments", "decision_bounds", "skill_version", "model_context_card"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{12}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skill_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_id": {"type": "string", "pattern": "^case_[0-9a-f]{12}$"},
    "subject_id": {"type": "string", "pattern": "^subj_[0-9a-f]{12}$"},
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_id", "endpoint_type", "definition", "allowed_classes", "value_name", "value_range"],
      "properties": {
        "endpoint_id": {"type": "string"},
        "endpoint_type": {"enum": ["binary_classification", "multiclass_classification", "ordinal_classification", "continuous_regression", "paired_change_classification", "paired_change_regression"]},
        "definition": {"type": "string", "minLength": 1},
        "allowed_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "value_name": {"type": ["string", "null"]},
        "value_range": {"type": ["array", "null"], "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}
      }
    },
    "sessions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["session_id", "visit_index", "days_from_baseline", "task_ids"],
        "properties": {
          "session_id": {"type": "string", "pattern": "^session_[0-9a-f]{10}$"},
          "visit_index": {"type": "integer", "minimum": 0},
          "days_from_baseline": {"type": ["number", "null"], "minimum": 0},
          "task_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "session_id", "task_family", "language", "available_modalities", "speaker_roles"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{10}$"},
          "session_id": {"type": "string"},
          "task_family": {"enum": ["picture_description", "structured_interview", "structured_multitask", "verbal_fluency", "spontaneous_narrative", "public_speech", "longitudinal_followup"]},
          "language": {"type": "string"},
          "available_modalities": {"type": "array", "items": {"enum": ["audio", "transcript", "task_metadata"]}, "uniqueItems": true},
          "speaker_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "quality_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["usable", "audio_reliability", "text_reliability", "role_confidence", "quality_evidence_ids", "failure_codes"],
      "properties": {
        "usable": {"type": "boolean"},
        "audio_reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "text_reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "role_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "quality_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "failure_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "supervised_prior": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint_type", "probabilities", "point_estimate", "interval", "uncertainty", "calibration_status", "source", "module_a_output_id"],
      "properties": {
        "endpoint_type": {"type": "string"},
        "probabilities": {"type": ["object", "null"], "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "point_estimate": {"type": ["number", "null"]},
        "interval": {"type": ["array", "null"], "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "calibration_status": {"enum": ["uncalibrated", "fold_internal", "external"]},
        "source": {"const": "supervised_module_a"},
        "module_a_output_id": {"type": "string"}
      }
    },
    "state_cards": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["state_id", "session_id", "task_id", "observability", "category", "severity", "confidence", "reference_scope", "within_state_method", "weight_version", "supporting_evidence_ids", "counterevidence_ids", "segment_ids", "trajectory_summary", "confound_tags", "report_permission"],
        "properties": {
          "state_id": {"type": "string", "pattern": "^S(0[1-9]|1[0-4])$"},
          "session_id": {"type": "string"},
          "task_id": {"type": "string"},
          "observability": {"enum": ["observable", "conditional", "unavailable"]},
          "category": {"enum": ["normal", "borderline", "impaired", "unreliable", "unavailable"]},
          "severity": {"type": ["number", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reference_scope": {"type": "string"},
          "within_state_method": {"type": "string"},
          "weight_version": {"type": "string"},
          "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "counterevidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "segment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "trajectory_summary": {"type": ["string", "null"]},
          "confound_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "report_permission": {"type": "boolean"}
        }
      }
    },
    "metric_evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "metric_id", "state_id", "session_id", "task_id", "speaker_role", "value", "unit", "reference_scope", "reference_provenance", "reference_median", "reference_scale", "directional_z", "observability", "reliability_components", "reliability", "missing", "confound_tags", "segment_ids", "evidence_role", "report_permission", "report_permission_basis", "metric_validation_id"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^[EQ][0-9]{3,}$"},
          "metric_id": {"type": "string"},
          "state_id": {"type": "string", "pattern": "^(S(0[1-9]|1[0-4])|QC)$"},
          "session_id": {"type": "string"},
          "task_id": {"type": "string"},
          "speaker_role": {"type": "string"},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string"},
          "reference_scope": {"type": "string"},
          "reference_provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "fold_id", "population", "training_only"],
            "properties": {
              "artifact_id": {"type": "string", "pattern": "^ref_[0-9a-f]{12}$"},
              "fold_id": {"type": "string", "minLength": 1},
              "population": {"enum": ["training_control", "training_all", "technical_rule"]},
              "training_only": {"const": true}
            }
          },
          "reference_median": {"type": ["number", "null"]},
          "reference_scale": {"type": ["number", "null"]},
          "directional_z": {"type": ["number", "null"]},
          "observability": {"enum": ["observable", "conditional", "unavailable"]},
          "reliability_components": {
            "type": "object", "additionalProperties": false,
            "required": ["coverage", "role_confidence", "alignment_confidence", "measurement_stability", "reference_support", "qc_penalty"],
            "properties": {
              "coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "role_confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "alignment_confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "measurement_stability": {"type": "number", "minimum": 0, "maximum": 1},
              "reference_support": {"type": "number", "minimum": 0, "maximum": 1},
              "qc_penalty": {"type": "number", "minimum": 0, "maximum": 1, "description": "1 means no QC penalty; 0 means fully suppressed"}
            }
          },
          "reliability": {"type": "number", "minimum": 0, "maximum": 1},
          "missing": {"type": "boolean"},
          "confound_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "segment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_role": {"enum": ["clinical_support", "model_auxiliary", "quality_control", "planned_unavailable"]},
          "report_permission": {"type": "boolean"},
          "report_permission_basis": {
            "enum": ["registry_yes", "conditional_validated", "blocked_registry_no", "blocked_condition", "blocked_role", "blocked_missing", "blocked_reliability", "blocked_unavailable", "blocked_planned"]
          },
          "metric_validation_id": {"type": ["string", "null"], "pattern": "^metricval_[0-9a-f]{12}$"}
        }
      }
    },
    "metric_validation_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_validation_id", "metric_id", "task_family", "language", "method_version", "status", "artifact_hash"],
        "properties": {
          "metric_validation_id": {"type": "string", "pattern": "^metricval_[0-9a-f]{12}$"},
          "metric_id": {"type": "string"},
          "task_family": {"type": "string"},
          "language": {"type": "string"},
          "method_version": {"type": "string", "minLength": 1},
          "status": {"enum": ["validated", "rejected"]},
          "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["segment_id", "session_id", "task_id", "speaker_role", "start_sec", "end_sec", "transcript", "audio_asset_id", "alignment_confidence", "diagnostic_disclosure", "prediction_eligible"],
        "properties": {
          "segment_id": {"type": "string", "pattern": "^segment_[0-9a-f]{10}$"},
          "session_id": {"type": "string"},
          "task_id": {"type": "string"},
          "speaker_role": {"type": "string"},
          "start_sec": {"type": ["number", "null"], "minimum": 0},
          "end_sec": {"type": ["number", "null"], "minimum": 0},
          "transcript": {"type": ["string", "null"]},
          "audio_asset_id": {"type": ["string", "null"], "pattern": "^asset_[0-9a-f]{12}$"},
          "alignment_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "diagnostic_disclosure": {"enum": ["none", "participant_self_report", "interviewer_or_metadata", "uncertain"]},
          "prediction_eligible": {"type": "boolean"}
        }
      }
    },
    "decision_bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["max_logit_delta", "max_standardized_value_delta", "allowed_actions", "minimum_reliability", "require_counterevidence_check"],
      "properties": {
        "max_logit_delta": {"type": ["number", "null"], "minimum": 0},
        "max_standardized_value_delta": {"type": ["number", "null"], "minimum": 0},
        "allowed_actions": {"type": "array", "items": {"enum": ["classify", "estimate", "hold_prior", "abstain", "retest"]}, "uniqueItems": true},
        "minimum_reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "require_counterevidence_check": {"type": "boolean"}
      }
    },
    "skill_version": {"type": "string"},
    "model_context_card": {
      "type": "object", "additionalProperties": false,
      "required": ["module_a_version", "module_b_version", "training_protocol", "known_limitations"],
      "properties": {
        "module_a_version": {"type": "string"},
        "module_b_version": {"type": "string"},
        "training_protocol": {"type": "string"},
        "known_limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
