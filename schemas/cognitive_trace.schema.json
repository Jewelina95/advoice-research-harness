{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advoice.local/schemas/cognitive_trace.schema.json",
  "title": "AD Voice auditable cognitive trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "config_hash", "data_snapshot_hash", "skill_hash", "trace_id", "case_id", "steps", "final_status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"}, "config_hash": {"type": "string"},
    "data_snapshot_hash": {"type": "string"}, "skill_hash": {"type": "string"},
    "trace_id": {"type": "string"},
    "case_id": {"type": "string"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "evidence_ids", "state_ids", "result", "violation_code", "rollback_to_step", "invalidated_evidence_ids", "invalidated_state_ids", "output_before", "output_after", "validator_result_id"],
        "properties": {
          "step_id": {"type": "integer", "minimum": 1},
          "action": {"enum": ["inspect_quality", "inspect_state", "inspect_metric", "inspect_segment", "compare_tasks", "form_hypothesis", "check_principles", "rollback", "submit", "stop"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "state_ids": {"type": "array", "items": {"type": "string"}},
          "result": {"type": "string"},
          "violation_code": {"type": ["string", "null"]},
          "rollback_to_step": {"type": ["integer", "null"], "minimum": 1},
          "invalidated_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "invalidated_state_ids": {"type": "array", "items": {"type": "string"}},
          "output_before": {"type": ["object", "null"]},
          "output_after": {"type": ["object", "null"]},
          "validator_result_id": {"type": ["string", "null"]}
        }
      }
    },
    "final_status": {"enum": ["submitted", "fallback_prior", "abstained", "retest"]}
  }
}
