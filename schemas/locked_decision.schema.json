{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Locked screening decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "config_hash", "data_snapshot_hash", "skill_hash", "decision_id", "case_id", "endpoint_type", "action", "final_class", "final_probabilities", "final_value", "final_interval", "uncertainty", "used_evidence_ids", "counterevidence_ids", "quality_evidence_ids", "module_a_output_id", "agent_decision_id", "validator_result_id", "module_b_output_id", "trace_id", "locked_at"],
  "properties": {
    "run_id": {"type": "string"}, "config_hash": {"type": "string"},
    "data_snapshot_hash": {"type": "string"}, "skill_hash": {"type": "string"},
    "decision_id": {"type": "string"},
    "case_id": {"type": "string"},
    "endpoint_type": {"type": "string"},
    "action": {"enum": ["classify", "estimate", "hold_prior", "abstain", "retest"]},
    "final_class": {"type": ["string", "null"]},
    "final_probabilities": {"type": ["object", "null"], "additionalProperties": {"type": "number"}},
    "final_value": {"type": ["number", "null"]},
    "final_interval": {"type": ["array", "null"], "items": {"type": "number"}},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "used_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "counterevidence_ids": {"type": "array", "items": {"type": "string"}},
    "quality_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "module_a_output_id": {"type": "string"},
    "agent_decision_id": {"type": ["string", "null"]},
    "validator_result_id": {"type": "string"},
    "module_b_output_id": {"type": "string"},
    "trace_id": {"type": "string"},
    "locked_at": {"type": "string", "format": "date-time"}
  }
}
