{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADvoice target route",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "endpoint", "labels", "requires_paired_visits", "minimum_visits"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "labels": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requires_paired_visits": {"type": "boolean"},
    "minimum_visits": {"type": "integer", "minimum": 1},
    "interval_field": {"type": "string"}
  }
}
