<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Evidence-State Pilot | Evaluation Report</title>
<style>
:root{--ink:#172126;--muted:#5f6b70;--line:#d9dfdc;--wash:#f5f7f6;--teal:#276f72;--warn:#a85d2a}*{box-sizing:border-box}body{margin:0;color:var(--ink);font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}header{background:var(--wash);border-bottom:1px solid var(--line);padding:46px max(24px,calc((100vw - 1220px)/2))}main{max-width:1220px;margin:auto;padding:0 24px}h1{margin:0 0 8px;font-size:clamp(28px,4vw,42px)}h2{font-size:26px;margin:0 0 10px}h3{font-size:18px;margin:24px 0 8px}.meta,.muted{color:var(--muted)}nav{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--line);padding:11px max(24px,calc((100vw - 1220px)/2));z-index:2}nav a{margin-right:18px;color:var(--ink);text-decoration:none}section{padding:38px 0;border-bottom:1px solid var(--line)}.notice{border-left:4px solid var(--warn);background:#fff5ed;padding:12px 16px;margin:16px 0}.figure{display:block;width:100%;height:auto;margin:18px 0 8px;border:1px solid var(--line)}.caption{font-size:13px;color:var(--muted)}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{background:var(--wash)}.undefined{color:var(--muted);font-style:italic}.stress{background:#fffaf5}.legend{display:flex;gap:10px;flex-wrap:wrap}.legend span{border:1px solid var(--line);padding:4px 8px;font-size:12px}.legend i{display:inline-block;width:10px;height:10px;margin-right:5px}.small{font-size:12px}@media(max-width:700px){header{padding:32px 20px}main{padding:0 16px}nav{overflow:auto;white-space:nowrap;padding-left:16px}.figure{min-width:0}table{display:block;overflow-x:auto;white-space:nowrap}}
</style></head><body>
<header><main><p class="meta">Evidence-State Agent Pilot · Evaluation Report</p><h1>Locked evaluation results</h1><p class="meta">Run: <code>{{ run.get('run_id', metadata.get('run_id', 'undefined')) }}</code> · Status: {{ status }}</p></main></header>
<nav><a href="#layer-a">Layer A</a><a href="#layer-b">Layer B</a><a href="#stress">Stress</a><a href="#failures">Failures</a><a href="system_report.html">System report</a></nav><main>
<section id="layer-a"><h2>Layer A | Medical prediction and screening</h2><p>Layer A reports locked aggregate performance. It does not pool stress data with trained pilot results. Undefined metrics remain undefined, with their denominator and reason shown below.</p><div class="legend">{% for arm in arms %}<span><i style="background:{{ {'B_raw':'#7d8790','B':'#5d6770','B_matched':'#5d6770','J-A':'#c97a52','J-S':'#4f8c89','J-AS':'#276f72'}.get(arm,'#276f72') }}"></i>{{ arm }}</span>{% endfor %}</div><img class="figure" src="{{ assets }}/layer_a_summary.png" alt="Layer A locked prediction metrics"><p class="caption">Values are plotted exactly as supplied by the aggregate JSON. No new statistic is computed by this report.</p><h3>Per-dataset metrics</h3>{% if layer_a %}<table><thead><tr><th>Dataset</th><th>Arm</th><th>Metric</th><th>Value</th><th>95% CI</th><th>n</th><th>Denominator</th><th>Undefined reason</th></tr></thead><tbody>{% for row in layer_a %}<tr><td>{{ row.dataset }}</td><td>{{ row.arm or 'Undefined' }}</td><td>{{ row.metric }}</td><td class="{{ 'undefined' if row.value is none else '' }}">{{ row.value_display }}</td><td>{{ row.ci_display }}</td><td>{{ row.n_display }}</td><td>{{ row.denominator_display }}</td><td>{{ row.undefined_display }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">No Layer A metrics were locked. The pilot is incomplete.</p>{% endif %}{% if paired %}<h3>Paired help and harm</h3><table><thead><tr><th>Dataset</th><th>Baseline</th><th>Arm</th><th>n</th><th>Helped</th><th>Harmed</th><th>Per-class help / harm</th></tr></thead><tbody>{% for row in paired %}<tr><td>{{ row.dataset_id }}</td><td>{{ row.baseline_arm }}</td><td>{{ row.arm }}</td><td>{{ row.n }}</td><td>{{ row.helped }}</td><td>{{ row.harmed }}</td><td>{% for label, counts in row.per_class.items() %}{{ label }}: {{ counts.helped }} / {{ counts.harmed }}{% if not loop.last %}; {% endif %}{% endfor %}</td></tr>{% endfor %}</tbody></table>{% endif %}<h3>Scope required by the protocol</h3><p class="small">Accuracy, balanced accuracy, macro F1, AUROC when defined, per-class sensitivity/specificity, calibration, confidence intervals, confusion matrices, and class help/harm are shown only when upstream aggregate rows provide them. Missing rows are not replaced with zeros.</p></section>
<section id="layer-b"><h2>Layer B | Technical framework proxies</h2><p>These are technical proxies, not physician-rated clinical safety. They cover citation validity, trace completeness, accepted and rejected repair, counterfactual consistency, fallback, API failure, coverage, and actual tokens/cost when supplied.</p><img class="figure" src="{{ assets }}/layer_b_summary.png" alt="Layer B technical proxy metrics"><p class="caption">Values are plotted exactly as supplied by the aggregate JSON.</p>{% if layer_b %}<table><thead><tr><th>Dataset</th><th>Arm</th><th>Proxy</th><th>Value</th><th>95% CI</th><th>n</th><th>Denominator</th><th>Undefined reason</th></tr></thead><tbody>{% for row in layer_b %}<tr><td>{{ row.dataset }}</td><td>{{ row.arm or 'Undefined' }}</td><td>{{ row.metric }}</td><td>{{ row.value_display }}</td><td>{{ row.ci_display }}</td><td>{{ row.n_display }}</td><td>{{ row.denominator_display }}</td><td>{{ row.undefined_display }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">No Layer B metrics were locked. The pilot is incomplete.</p>{% endif %}</section>
<section id="stress"><h2>Stress results</h2><p>Stress sets are reported separately and are not pooled into a clinical headline average.</p>{% if layer_a_stress or layer_b_stress %}<table><thead><tr><th>Layer</th><th>Dataset</th><th>Arm</th><th>Metric</th><th>Value</th><th>n / denominator</th><th>Reason</th></tr></thead><tbody>{% for row in layer_a_stress %}<tr class="stress"><td>A</td><td>{{ row.dataset }}</td><td>{{ row.arm }}</td><td>{{ row.metric }}</td><td>{{ row.value_display }}</td><td>{{ row.n_display }} / {{ row.denominator_display }}</td><td>{{ row.undefined_display }}</td></tr>{% endfor %}{% for row in layer_b_stress %}<tr class="stress"><td>B</td><td>{{ row.dataset }}</td><td>{{ row.arm }}</td><td>{{ row.metric }}</td><td>{{ row.value_display }}</td><td>{{ row.n_display }} / {{ row.denominator_display }}</td><td>{{ row.undefined_display }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">No stress results were locked.</p>{% endif %}</section>
<section id="failures"><h2>Failures, fallbacks, and cost</h2>{% if failures %}<table><thead><tr><th>Failure or fallback</th><th>Detail</th></tr></thead><tbody>{% for item in failures %}<tr><th>{{ item.name }}</th><td>{{ item.detail }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">No failure rows were supplied. This is not evidence that the run had zero failures.</p>{% endif %}<p class="notice">SpeechCARE superiority is not evaluated: matching formal protocol artifacts are not present in this report input. Historical scores, if supplied upstream, must remain labeled historical and are not paired improvements.</p><p class="muted">No patient transcript or per-case clinician report is included.</p></section>
<footer class="muted">Generated from locked aggregate JSON. Undefined is a result state, not zero.</footer></main></body></html>
