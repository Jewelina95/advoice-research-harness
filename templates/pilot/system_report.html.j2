<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Evidence-State Pilot | System Report</title>
<style>
:root{--ink:#172126;--muted:#5f6b70;--line:#d9dfdc;--wash:#f5f7f6;--teal:#276f72;--warn:#a85d2a}*{box-sizing:border-box}body{margin:0;color:var(--ink);font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}header{background:var(--wash);border-bottom:1px solid var(--line);padding:48px max(24px,calc((100vw - 1180px)/2))}main{max-width:1180px;margin:auto;padding:0 24px}h1{margin:0 0 8px;font-size:clamp(28px,4vw,42px)}h2{margin:0 0 12px;font-size:25px}h3{margin:22px 0 8px;font-size:18px}.meta,.muted{color:var(--muted)}nav{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--line);padding:11px max(24px,calc((100vw - 1180px)/2));z-index:2}nav a{margin-right:18px;color:var(--ink);text-decoration:none}section{padding:38px 0;border-bottom:1px solid var(--line)}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{background:var(--wash)}code{font:12px ui-monospace,SFMono-Regular,monospace;overflow-wrap:anywhere}.notice{border-left:4px solid var(--warn);background:#fff5ed;padding:12px 16px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.panel{border:1px solid var(--line);padding:16px}.chips{display:flex;gap:8px;flex-wrap:wrap}.chip{border:1px solid var(--line);padding:5px 9px;background:var(--wash);font-size:13px}@media(max-width:700px){header{padding:32px 20px}main{padding:0 16px}nav{overflow:auto;white-space:nowrap;padding-left:16px}.grid{grid-template-columns:1fr}table{display:block;overflow-x:auto;white-space:nowrap}}
</style></head><body>
<header><main><p class="meta">Evidence-State Agent Pilot · System Report</p><h1>{{ metadata.get('title', 'Implemented pilot pipeline') }}</h1><p class="meta">Status: {{ status }} · Run: <code>{{ run.get('run_id', metadata.get('run_id', 'undefined')) }}</code> · Aggregate: <code>{{ source_aggregate }}</code> · Hash: <code>{{ aggregate_hash }}</code></p></main></header>
<nav><a href="#data">Data</a><a href="#pipeline">Pipeline</a><a href="#trace">Trace example</a><a href="#limits">Limits</a><a href="evaluation_report.html">Evaluation report</a></nav><main>
<section id="data"><h2>Dataset inputs and split</h2>{% if datasets %}<table><thead><tr><th>Dataset</th><th>Channel</th><th>Partition</th><th>Subjects</th><th>Tasks / languages</th><th>Status</th></tr></thead><tbody>{% for d in datasets %}<tr><td>{{ d.get('display_name', d.get('dataset_id', 'Undefined')) }}</td><td>{{ d.get('channel', 'Undefined') }}</td><td>{{ d.get('partition', d.get('split', 'Undefined')) }}</td><td>{{ d.get('subjects', d.get('n', 'Undefined')) }}</td><td>{{ d.get('tasks', d.get('languages', 'Undefined')) }}</td><td>{{ d.get('status', 'Undefined') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">No dataset inventory was locked into this aggregate.</p>{% endif %}</section>
<section id="pipeline"><h2>Implemented pipeline</h2><div class="grid"><div class="panel"><h3>Executed components</h3><p>{{ pipeline.get('description', 'The aggregate does not describe an executed pipeline.') }}</p>{% for key,value in pipeline.items() if key != 'description' %}<p><strong>{{ key }}:</strong> {{ value }}</p>{% endfor %}</div><div class="panel"><h3>Versions and configuration</h3>{% if versions %}{% for key,value in versions.items() %}<p><strong>{{ key }}:</strong> <code>{{ value }}</code></p>{% endfor %}{% else %}<p class="muted">No versions were locked.</p>{% endif %}</div></div><p class="muted">Reports read locked aggregate JSON only. They do not refit, resample, select subjects, or infer missing metrics.</p><h3>Arms</h3><div class="chips">{% for arm in arms %}<span class="chip">{{ arm }}</span>{% endfor %}</div></section>
<section id="trace"><h2>De-identified trace example</h2>{% if trace %}<table><tbody>{% for key,value in trace.items() %}<tr><th>{{ key }}</th><td><code>{{ value }}</code></td></tr>{% endfor %}</tbody></table><p class="muted">This trace contains identifiers and hashes only. No patient transcript or per-case clinician report is rendered.</p>{% else %}<p class="muted">No label-free trace example was locked into this run.</p>{% endif %}</section>
<section id="limits"><h2>Unresolved limits and failures</h2>{% if limits %}<ul>{% for item in limits if item is not string %}<li>{{ item }}</li>{% endfor %}{% for item in limits if item is string %}<li>{{ item }}</li>{% endfor %}</ul>{% else %}<p class="muted">No unresolved limits were supplied. This is not evidence that none exist.</p>{% endif %}{% if failures %}<div class="notice"><strong>Incomplete or failed items remain in the report.</strong><ul>{% for item in failures %}<li><strong>{{ item.name }}:</strong> {{ item.detail }}</li>{% endfor %}</ul></div>{% endif %}</section>
<footer class="muted">Generated from {{ source_aggregate }}. Missing and undefined values are preserved.</footer></main></body></html>
